#!/usr/bin/env bash
# =====================================================
# PG2-Cheetos — Build Script (Linux / macOS)
# Cross-compiles PG2-Cheetos.dll & optional injector
# using MinGW-w64
# =====================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
BUILD_DIR="$PROJECT_ROOT/build"
BIN_DIR="$BUILD_DIR/bin"
CONFIG_FILE="$PROJECT_ROOT/config.json"
TOOLCHAIN_FILE="$PROJECT_ROOT/resources/cmake/mingw-toolchain.cmake"

PROJECT_NAME="PG2-Cheetos"
if [ -f "$CONFIG_FILE" ]; then
    PARSED_NAME=$(grep -o '"project"[[:space:]]*:[[:space:]]*"[^"]*"' "$CONFIG_FILE" | sed -E 's/.*"project"[[:space:]]*:[[:space:]]*"([^"]*)".*/\1/' || true)
    if [ -n "$PARSED_NAME" ]; then
        PROJECT_NAME="$PARSED_NAME"
    fi
fi
DLL_NAME="${PROJECT_NAME}.dll"
INJECTOR_NAME="${PROJECT_NAME}_Injector.exe"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
PURPLE='\033[0;35m'
NC='\033[0m'

info()    { echo -e "  ${CYAN}[*]${NC} $*"; }
success() { echo -e "  ${GREEN}[+]${NC} $*"; }
warn()    { echo -e "  ${YELLOW}[!]${NC} $*"; }
error()   { echo -e "  ${RED}[!]${NC} $*"; }

usage() {
    echo "  Usage: $0 [command] [options]"
    echo ""
    echo "  Commands:"
    echo "    release        — Build in Release mode (default, no debug logs)"
    echo "    debug          — Build in Debug mode (ENABLE_DEBUG_LOG enabled)"
    echo "    clean          — Remove build directory"
    echo "    rebuild        — Clean + build"
    echo "    help           — Show this help message"
    echo ""
    echo "  Options:"
    echo "    --release      — Build in Release mode"
    echo "    --debug        — Build in Debug mode"
    echo "    --injector     — Also build standalone ${INJECTOR_NAME} (off by default)"
    echo ""
}

check_deps() {
    local missing=()
    for cmd in cmake x86_64-w64-mingw32-g++; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if ! command -v ninja &>/dev/null && ! command -v make &>/dev/null; then
        missing+=("ninja or make")
    fi

    if [ ${#missing[@]} -ne 0 ]; then
        error "Missing dependencies: ${missing[*]}"
        exit 1
    fi
}

clean_build() {
    if [ -d "$BUILD_DIR" ]; then
        info "Removing build directory..."
        rm -rf "$BUILD_DIR"
        success "Clean complete"
    else
        info "Nothing to clean"
    fi
}

build_project() {
    local build_type="${1:-Release}"
    local build_injector="${2:-OFF}"

    local generator="Unix Makefiles"
    if command -v ninja &>/dev/null; then
        generator="Ninja"
    fi

    info "Configuring CMake (type: ${build_type}, injector: ${build_injector}, generator: ${generator})..."
    cmake -S "$PROJECT_ROOT" -B "$BUILD_DIR" \
        -G "$generator" \
        -DCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN_FILE" \
        -DCMAKE_BUILD_TYPE="$build_type" \
        -DBUILD_INJECTOR="$build_injector"

    local jobs
    jobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

    info "Building with ${jobs} jobs..."
    cmake --build "$BUILD_DIR" -j"$jobs"

    if [ ! -f "$BIN_DIR/$DLL_NAME" ]; then
        error "Build failed — $DLL_NAME not produced."
        exit 1
    fi

    echo ""
    success "Build complete (${build_type})!"
    success "  $DLL_NAME      -> $BIN_DIR/$DLL_NAME"
    if [ "$build_injector" = "ON" ]; then
        success "  $INJECTOR_NAME -> $BIN_DIR/$INJECTOR_NAME"
    else
        info "  $INJECTOR_NAME skipped (pass --injector to build)"
    fi
}

main() {
    local action="build"
    local build_type="Release"
    local build_injector="OFF"

    for arg in "$@"; do
        case "$arg" in
            release|--release)
                build_type="Release"
                ;;
            debug|--debug)
                build_type="Debug"
                ;;
            --injector|--with-injector)
                build_injector="ON"
                ;;
            clean)
                action="clean"
                ;;
            rebuild)
                action="rebuild"
                ;;
            help|-h|--help)
                usage
                exit 0
                ;;
            *)
                error "Unknown argument: $arg"
                usage
                exit 1
                ;;
        esac
    done

    check_deps

    case "$action" in
        clean)
            clean_build
            ;;
        rebuild)
            clean_build
            build_project "$build_type" "$build_injector"
            ;;
        build)
            build_project "$build_type" "$build_injector"
            ;;
    esac
}

main "$@"
